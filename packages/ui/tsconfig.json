{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/ui/*"],
      "@/components/ui/*": ["./src/components/ui/*"]
    },
    "outDir": "dist",
    "strictNullChecks": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
